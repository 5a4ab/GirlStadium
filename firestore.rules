rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's profile lives at users/{uid}, keyed by their own
    // Firebase Authentication UID. A user may only read or write their
    // own document - never another user's.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
